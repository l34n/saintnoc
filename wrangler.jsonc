{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saintnoc",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "saintnoc.org",
      "custom_domain": true
    }
  ]
}
